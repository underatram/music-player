{
  "name": "music-player",
  "productName": "Music",
  "version": "0.17.0",
  "description": "A music player for your local library",
  "homepage": "https://github.com/underatram/music-player",
  "repository": {
    "type": "git",
    "url": "https://github.com/underatram/music-player.git"
  },
  "license": "MIT",
  "desktopName": "music-player.desktop",
  "main": "electron/main.js",
  "author": {
    "name": "underatram",
    "email": "19960972+underatram@users.noreply.github.com"
  },
  "scripts": {
    "start": "electron .",
    "helper": "gcc -O2 native/ipod-helper.c -o native/ipod-helper $(pkg-config --cflags --libs libgpod-1.0)",
    "dist": "npm run helper && electron-builder --linux deb"
  },
  "build": {
    "appId": "io.github.underatram.music",
    "files": [
      "index.html",
      "style.css",
      "js/**",
      "fonts/**",
      "electron/**",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "native/ipod-helper",
        "to": "ipod-helper"
      }
    ],
    "deb": {
      "recommends": [
        "libgpod4t64",
        "libgpod-common"
      ]
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": "deb",
      "category": "AudioVideo",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "maintainer": "underatram <19960972+underatram@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
